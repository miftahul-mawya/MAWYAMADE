rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        request.auth.token.email == 'REPLACE_WITH_YOUR_REAL_ADMIN_EMAIL';
    }

    match /community/{userId}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId
        && request.resource.size < 40 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*'));
    }

    match /recipes/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}