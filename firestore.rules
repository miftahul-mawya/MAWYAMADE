rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        request.auth.token.email == 'REPLACE_WITH_YOUR_REAL_ADMIN_EMAIL';
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1200
        && request.resource.data.type is string;
      allow update, delete: if signedIn() &&
        (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow update, delete: if signedIn() &&
          (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 90;
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if true;
      // Only trusted Cloud Functions (Admin SDK) may write notifications.
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && (request.auth.uid == userId || isAdmin());
    }
  }
}